[core]
  editor = nvim

[pager]
  diff = delta
  log = delta
  reflog = delta
  show = delta

[delta]
  navigate = true

[interactive]
  diffFilter = delta --color-only

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[alias]
  agent = !git -c user.name="Agent" -c user.email="agent@local"
